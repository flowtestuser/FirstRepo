    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
